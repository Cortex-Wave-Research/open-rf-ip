# Clock: Lattice FPGA-EB-02028-1.7 Table 5.1, U1 12 MHz, JP2 in / JP1 out.
# Pin/IO types corroborated by Project Oxide examples/lram_evn/evn.pdc.
# LED0: Project Oxide examples/blinky_evn/evn.pdc. Active low.
ldc_set_location -site {L13} [get_ports clk]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports clk]
ldc_set_location -site {E17} [get_ports activity]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports activity]
# Clock period is supplied by nextpnr --freq (12 MHz for the native run).
