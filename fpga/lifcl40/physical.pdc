# Lattice FPGA-EB-02028-1.7, Tables 5.1 / 7.3; Oxide blinky_evn corroborates LEDs.
# U1 12 MHz: JP2 closed, JP1 open. Bank 1 fixed 3.3 V. LEDs active low.
ldc_set_location -site {L13} [get_ports clk]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports clk]
ldc_set_location -site {E17} [get_ports heartbeat_n]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports heartbeat_n]
ldc_set_location -site {F13} [get_ports chirp_led_n]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports chirp_led_n]
