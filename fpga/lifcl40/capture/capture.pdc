# FPGA-EB-02028-1.7 Figures A.3/A.7. JP2 closed; bank 1 = 3.3 V.
ldc_set_location -site {L13} [get_ports clk_12mhz]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports clk_12mhz]
ldc_set_location -site {F20} [get_ports scl]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports scl]
ldc_set_location -site {E20} [get_ports sda]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports sda]
ldc_set_location -site {E17} [get_ports led0]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports led0]
ldc_set_location -site {F13} [get_ports led1]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports led1]
create_clock -name native_12mhz -period 83.33333333333333 [get_ports clk_12mhz]
